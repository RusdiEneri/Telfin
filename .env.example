BOT_TOKEN=isi_token_botfather
# Whitelist Telegram User ID (hanya ID di array ini yang bisa akses bot, format Array JSON)
ALLOWED_USER_IDS=["123456789"]

# AI Provider: gemini atau openai
AI_PROVIDER=gemini

# Jika menggunakan Gemini (default model: gemini-3.5-flash)
GEMINI_API_KEY=isi_api_key_kamu
# GEMINI_MODEL=gemini-3.5-flash

# Jika menggunakan OpenAI (default model: gpt-4o-mini)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini